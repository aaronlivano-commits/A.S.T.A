{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "backend": {
      "source": {
        "root": "backend"
      },
      "build": {
        "builder": "RAILPACK"
      },
      "deploy": {
        "startCommand": "python3 -m uvicorn main:app --host 0.0.0.0 --port $PORT"
      }
    },
    "frontend": {
      "source": {
        "root": "frontend"
      },
      "build": {
        "builder": "RAILPACK"
      }
    }
  }
}
