{
  "$schema": "https://vercel.sh",
  "services": {
    "frontend-service": {
      "root": "frontend/"
    },
    "backend-service": {
      "root": "backend/",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend-service",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend-service",
        "path": "/$1"
      }
    }
  ]
}
